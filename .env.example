# Copie ce fichier en `.env.local` et remplis les valeurs.
# Les variables NEXT_PUBLIC_* sont inlinées AU BUILD : les changer en production
# exige un redéploiement, pas seulement un redémarrage.

# ── Supabase (requis — validé au boot par src/env.ts) ────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Domaine des sites clients ────────────────────────────────────────────────
# Domaine racine servant TOUS les sous-domaines clients. Source unique :
# src/lib/site-domain.ts. Mets l'apex, pas "app." — la valeur est normalisée.
#   {label}.<domaine> → site publié
#   {uuid}.<domaine>  → aperçu privé d'un brouillon/template
# Prérequis infra (aucun code ne le fait) : wildcard DNS *.<domaine> vers Vercel
# ET domaine "*.<domaine>" ajouté au projet Vercel (Settings → Domains).
NEXT_PUBLIC_SITE_DOMAIN=samadigitalstudio.fr
# Ancien nom, encore lu en repli par SITE_DOMAIN. Ne définis qu'UNE des deux.
# NEXT_PUBLIC_APP_DOMAIN=samadigitalstudio.fr
# URL absolue du CRM. Par défaut https://app.<NEXT_PUBLIC_SITE_DOMAIN>.
# NEXT_PUBLIC_APP_URL=https://app.samadigitalstudio.fr

# ── Scraper Google Maps sur ECS (requis — validé par src/env.ts) ─────────────
GMAPS_AWS_REGION=eu-west-3
GMAPS_AWS_CLUSTER=
GMAPS_AWS_SERVICE=
GMAPS_API_TOKEN=
# GMAPS_BASE_URL=

# ── IA ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# Secret de signature du webhook Resend (Dashboard → Webhooks → Signing Secret),
# de la forme `whsec_…`. Il alimente le vérificateur d'adresses : un rebond dur
# condamne l'adresse, une livraison la reconduit pour 120 jours.
# EN PRODUCTION, sans lui, /api/webhooks/resend REFUSE tout — n'importe qui
# pourrait sinon condamner nos adresses en postant de faux rebonds.
# RESEND_WEBHOOK_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Téléphonie ───────────────────────────────────────────────────────────────
# TELEPHONY_PROVIDER=zadarma
# ZADARMA_KEY=
# ZADARMA_SECRET=
# ZADARMA_WEBHOOK_SECRET=
# RENDER_PROVIDER=
# RENDER_API_KEY=
# RENDER_API_URL=

# ── Google Calendar (module Rendez-vous) ─────────────────────────────────────
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Cron (au moins un des deux est requis en production) ─────────────────────
# CRON_SECRET=
# PG_CRON_SECRET=

# ── Divers ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# API_ALLOWED_ORIGINS=https://app.samadigitalstudio.fr
# ADMIN_BACKFILL_SECRET=
